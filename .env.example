# ──────────────────────────────────────────────────────────────
# VisionMob — Variables de entorno
# Copia como .env y rellena los valores. NUNCA subas .env al repo.
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_DB=visionmob
POSTGRES_USER=visionmob
POSTGRES_PASSWORD=changeme

# ── FastAPI ──
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
DEBUG=true
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:5173"]

# ── Cloudflare R2 (dejar vacío en local hasta US-08) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=visionmob-audio
R2_PUBLIC_URL=

# ── Email / Resend (dejar vacío en local hasta US-18) ──
RESEND_API_KEY=
EMAIL_FROM=noreply@visionmob.com