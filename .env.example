# ──────────────────────────────────────
# VisionMob — Variables de entorno
# Copia este archivo como .env y rellena los valores
# NUNCA subas .env al repositorio
# ──────────────────────────────────────

# ── Base de datos ──
POSTGRES_DB=visionmob
POSTGRES_USER=visionmob
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://visionmob:changeme@db:5432/visionmob

# ── FastAPI ──
SECRET_KEY=changeme-generate-a-real-secret
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173

# ── Cloudflare R2 ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=visionmob-audio
R2_PUBLIC_URL=

# ── Email (Resend) ──
RESEND_API_KEY=
EMAIL_FROM=noreply@visionmob.com